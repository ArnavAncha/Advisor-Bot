// Reusable Card component for KPIs
const Card = ({ title, value, change, updated, changeColor = 'text-green-500' }) => (
  <div className="card">
    <h3 className="text-xl font-medium text-gray-300">{title}</h3>
    <p className="text-3xl font-bold mt-2">
      <span className="value">{value}</span>
      {change && <span className={`text-xl font-medium ml-2 ${changeColor}`}>{change}</span>}
    </p>
    {updated && <span className="updated">Updated via {updated}</span>}
  </div>
);

// The component responsible for rendering the TradingView widget
const StockWidget = ({ symbol }) => {
  const widgetId = 'tradingview-chart-container';

  useEffect(() => {
    // Check if the script has already been loaded to prevent duplicates
    if (document.getElementById(widgetId).querySelector('script')) {
      return;
    }

    const script = document.createElement('script');
    script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-advanced-chart.js';
    script.async = true;

    // The configuration for the widget is passed as an object
    script.innerHTML = JSON.stringify({
      "symbol": symbol,
      "interval": "D",
      "timezone": "Etc/UTC",
      "theme": "dark",
      "style": "2",
      "locale": "en",
      "withdateranges": true,
      "allow_symbol_change": true,
      "container_id": widgetId,
    });

    const container = document.getElementById(widgetId);
    if (container) {
      container.appendChild(script);
    }

    // Cleanup function to remove the widget when the component unmounts
    return () => {
      const existingScript = container?.querySelector('script');
      if (existingScript) {
        container.removeChild(existingScript);
      }
    };
  }, [symbol]); // The effect re-runs if the 'symbol' prop changes

  return (
    <div id={widgetId} className="w-full h-full">
      <div className="tradingview-widget-container__widget"></div>
    </div>
  );
};
        

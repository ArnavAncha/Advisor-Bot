# API Configuration
DEBUG=False
API_TITLE=Advisor Bot API
API_VERSION=1.0.0

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/advisor_bot

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379

# External APIs
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
TRADINGVIEW_API_KEY=your_tradingview_key
POLYGON_API_KEY=your_polygon_key

# Chase Bank Integration
CHASE_API_BASE_URL=https://api.chase.com
CHASE_CLIENT_ID=your_chase_client_id
CHASE_CLIENT_SECRET=your_chase_client_secret
